# ── Motor 1 · OpenAI ────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Motor 2 · Google (Gemini con búsqueda) ──────────────────
# Con GEMINI_USE_GROUNDING=true la respuesta se apoya en el índice de Google y
# devuelve las fuentes citadas. El grounding tiene un tramo gratuito diario
# amplio; por encima se factura aparte. Si falla, el cliente reintenta sin
# grounding automáticamente.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_USE_GROUNDING=true

# ── Ejecución ───────────────────────────────────────────────
ENGINE_TIMEOUT_MS=45000
