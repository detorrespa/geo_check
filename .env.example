# ── Motor 1 · OpenAI ────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Motor 2 · Google (Gemini con búsqueda) ──────────────────
# Con GEMINI_USE_GROUNDING=true la respuesta se apoya en el índice de Google y
# devuelve las fuentes citadas. El grounding tiene un tramo gratuito diario
# amplio; por encima se factura aparte. Si falla, el cliente reintenta sin
# grounding automáticamente.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
GEMINI_USE_GROUNDING=true

# ── Ejecución ───────────────────────────────────────────────
ENGINE_TIMEOUT_MS=45000

# ── Supabase ────────────────────────────────────────────────
# La clave publicable es pública por diseño: viaja en el bundle del navegador
# y lo que protege los datos es el RLS. La secreta NUNCA va aquí ni lleva
# prefijo VITE_: Vite incrusta en el bundle todo lo que empiece por VITE_.
VITE_SUPABASE_URL=https://orrevxnmrxskswgtfnmr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Secretos de las Edge Functions ──────────────────────────
# Estos NO van en este archivo: se cargan en Supabase con
#   supabase secrets set --env-file supabase/.env.functions
#
#   OPENAI_API_KEY, GOOGLE_API_KEY, GOOGLE_MODEL
#   RATE_LIMIT_SALT   cadena larga y aleatoria; sin ella no se limita por IP
#   ALLOWED_ORIGINS   https://geo.nektiu.com (coma para varios)
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase solo.
