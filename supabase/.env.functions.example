# Copia a supabase/.env.functions (gitignorado) y rellena.
# Luego: supabase secrets set --env-file supabase/.env.functions
#
# No pongas SUPABASE_URL ni SUPABASE_SERVICE_ROLE_KEY: las inyecta Supabase.

OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
RATE_LIMIT_SALT=
ALLOWED_ORIGINS=
RESEND_API_KEY=
